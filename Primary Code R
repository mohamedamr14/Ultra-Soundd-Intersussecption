# Function to run meta4diag for a single covariate
run_meta4diag_cov <- function(df, covariate) {
  # remove rows with NA in covariate
  df_clean <- df[!is.na(df[[covariate]]), ]
  
  # run model
  model <- meta4diag(
    data = df_clean,
    model.type = 1,
    var2.prior = "Hcauchy",
    cor.prior = "Normal",
    var2.par = c(2.5),
    covariates = covariate
  )
  return(model)
}

